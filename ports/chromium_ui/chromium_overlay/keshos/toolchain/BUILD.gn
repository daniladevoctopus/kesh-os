#
# KeshOS target toolchain for Chromium's GN build. Host-side generator tools
# continue to use Chromium's normal Linux host toolchain.

import("//build/toolchain/gcc_toolchain.gni")

declare_args() {
  # Must point to the KeshOS musl sysroot. Use a path without spaces.
  keshos_sysroot = ""

  # Directory containing clang, clang++, llvm-ar, llvm-nm and llvm-readelf.
  keshos_clang_bin = "/usr/bin"
}

assert(keshos_sysroot != "", "Set keshos_sysroot in args.gn")

gcc_toolchain("kesh_x64") {
  cc = "$keshos_clang_bin/clang"
  cxx = "$keshos_clang_bin/clang++"
  ld = cxx
  ar = "$keshos_clang_bin/llvm-ar"
  nm = "$keshos_clang_bin/llvm-nm"
  readelf = "$keshos_clang_bin/llvm-readelf"

  # KeshOS currently exposes a musl/Linux-compatible userspace ABI, but the
  # executable still runs on the KeshOS kernel. --sysroot prevents host
  # CachyOS headers/libraries from leaking into target objects.
  #
  # KeshOS' ELF loader intentionally accepts ET_EXEC only and rejects dynamic
  # executables. Chromium's generic Linux build defaults to PIE, so make the
  # final target explicitly non-PIE and static.
  extra_cflags =
      "--target=x86_64-unknown-linux-musl --sysroot=\"$keshos_sysroot\" " +
      "-fno-pie"
  extra_cxxflags =
      "--target=x86_64-unknown-linux-musl --sysroot=\"$keshos_sysroot\" " +
      "-D_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE -fno-pie"
  extra_ldflags =
      "--target=x86_64-unknown-linux-musl --sysroot=\"$keshos_sysroot\" " +
      "-static -no-pie -fuse-ld=lld"

  enable_linker_map = false

  toolchain_args = {
    current_cpu = "x64"
    current_os = "linux"

    # Compile-time ABI bridge only. Runtime graphics/input is OzoneKesh.
    is_clang = true
    use_lld = true
    use_remoteexec = false

    # Do not let Chromium's Debian target sysroot leak into KeshOS objects.
    use_sysroot = false
    sysroot = keshos_sysroot

    # Chromium's stock Linux Rust target is GNU rather than musl. The first
    # Ozone/Aura milestones deliberately avoid Rust targets.
    enable_rust = false
  }
}
