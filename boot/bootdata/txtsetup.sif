l_intl.nls   = 1,,,,,,,2,,,,1,2
pci.sys      = 1,,,,,,x,4,,,,1,4
scsiport.sys = 1,,,,,,,4,,,,1,4
storport.sys = 1,,,,,,,4,,,,1,4
fastfat.sys  = 1,,,,,,x,4,,,,1,4
