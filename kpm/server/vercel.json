{
  "version": 2,
  "rewrites": [
    { "source": "/packages.json", "destination": "/api/catalog" },
    { "source": "/index-v2.json", "destination": "/api/catalog" },
    { "source": "/packages/:pkg", "destination": "/api/download?pkg=:pkg" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, User-Agent" }
      ]
    }
  ]
}
